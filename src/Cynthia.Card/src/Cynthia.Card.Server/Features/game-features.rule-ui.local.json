      "Description": { "ZhCn": "本地验收用的服务端状态；数字表示层数。", "En": "Server-authored local fixture; the number is its stack count." },
      "ShortLabel": "毒", "StyleToken": "venom", "ValueDisplay": "stack", "Priority": 20
    },
    {
      "Id": "local.echo", "Name": { "ZhCn": "回响", "En": "Echo" },
      "Description": { "ZhCn": "同一种状态可以按实例同时存在。", "En": "Multiple instances of one marker can coexist." },
      "ShortLabel": "响", "StyleToken": "arcane", "ValueDisplay": "number", "AllowMultipleInstances": true, "Priority": 10
    }
  ],
  "ResourceDefinitions": [
    {
      "Id": "local.coins", "Name": { "ZhCn": "金币", "En": "Coins" },
      "Description": { "ZhCn": "由服务端提供的局内资源示例，上限为9。", "En": "A server-authored in-match resource fixture, capped at 9." },
      "ShortLabel": "金币", "StyleToken": "amber", "ValueFormat": "fraction", "Priority": 20
    },
    {
      "Id": "local.momentum", "Name": { "ZhCn": "势能", "En": "Momentum" },
      "Description": { "ZhCn": "", "En": "" },
