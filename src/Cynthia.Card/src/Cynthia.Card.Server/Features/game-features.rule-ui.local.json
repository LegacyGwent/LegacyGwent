  "RuleCards": [
    {
      "Id": "99001", "Name": { "ZhCn": "百卡实验", "En": "Hundred Card Lab" },
      "Description": { "ZhCn": "将卡组上限提高至100张。", "En": "Raises the deck maximum to 100." },
      "ArtId": "11210100", "Priority": 10, "PlayerSelectable": true, "SortOrder": 10,
      "RemoveConstraintIds": ["base.deck-size"],
      "AddConstraints": [{ "Id": "local.deck-size", "Kind": "deck-size", "Min": 25, "Max": 100 }]
    },
    {
      "Id": "99002", "Name": { "ZhCn": "金银解禁", "En": "Gold and Silver Unbound" },
      "Description": { "ZhCn": "取消金色、银色卡的数量与同名限制。", "En": "Removes gold and silver count and duplicate limits." },
      "ArtId": "11210200", "Priority": 20, "PlayerSelectable": true, "SortOrder": 20,
      "ExclusiveWith": ["99003"],
      "RemoveConstraintIds": ["base.gold-count", "base.silver-count", "base.gold-copies", "base.silver-copies"]
    },
    {
      "Id": "99003", "Name": { "ZhCn": "铜色试炼", "En": "Copper Trial" },
      "Description": { "ZhCn": "只能携带铜色卡，且铜色卡同名限1张。", "En": "Only copper cards; one copy of each." },
      "ArtId": "11210300", "Priority": 30, "PlayerSelectable": true, "SortOrder": 30,
      "ExclusiveWith": ["99002", "99005"],
      "RemoveConstraintIds": ["base.gold-count", "base.silver-count", "base.copper-copies"],
      "AddConstraints": [
        { "Id": "local.copper-only", "Kind": "allow-cards", "Filter": { "Groups": ["Copper"] } },
        { "Id": "local.copper-copies", "Kind": "copy-count", "Filter": { "Groups": ["Copper"] }, "Max": 1 }
      ]
    },
    {
      "Id": "99004", "Name": { "ZhCn": "饕餮回响", "En": "Feast Echo" },
      "Description": { "ZhCn": "吞噬能力触发两次（事件规则样本）。", "En": "Consume abilities trigger twice (event-rule fixture)." },
      "ArtId": "11210400", "Priority": 40, "PlayerSelectable": true, "SortOrder": 40
    },
    {
      "Id": "99005", "Name": { "ZhCn": "帝国远征令", "En": "Imperial Expedition" },
      "Description": { "ZhCn": "仅限帝国领袖，需要百卡实验，并将怪兽卡加入可选卡池。", "En": "Nilfgaard leaders only; requires Hundred Card Lab and adds Monsters cards to the pool." },
      "ArtId": "11210500", "Priority": 50, "PlayerSelectable": true, "SortOrder": 50,
      "AllowedLeaderFactions": ["Nilfgaard"],
      "AddCardPools": ["local.monsters"],
      "RequiresAll": ["99001"],
      "ExclusiveWith": ["99003"]
    },
    {
      "Id": "99006", "Name": { "ZhCn": "空白契约", "En": "Blank Contract" },
      "Description": { "ZhCn": "卡组必须为空，普通可选卡池也为空。", "En": "Requires an empty deck and exposes an empty ordinary-card pool." },
      "ArtId": "11210600", "Priority": 60, "PlayerSelectable": true, "SortOrder": 60,
      "ExclusiveWith": ["99001", "99002", "99003", "99004", "99005"],
      "RemoveConstraintIds": ["base.deck-size"],
      "RestrictToCardPools": ["local.empty"],
      "AddConstraints": [{ "Id": "local.empty-size", "Kind": "deck-size", "Min": 0, "Max": 0 }]
    }
  ],
