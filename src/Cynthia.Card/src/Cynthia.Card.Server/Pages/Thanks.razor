@page "/thank"
@inject SiteTextService Text

<SitePage Eyebrow="@L("社区支持档案", "Community support archive")"
          Title="@L("每一份支持，都留在这里", "Every contribution left a mark")"
          Description="@L("这份名单记录了早期为服务器与社区提供支持的朋友，以及他们留下的话。", "This archive remembers the people who supported the server and community in its early years, together with the messages they left.")"
          Icon="oi-people"
          CssClass="aitest-page--supporters">
    <Aside>
        <strong>@TotalAmount.ToString("0.##")</strong>
        <span>@L("累计记录金额", "recorded total")</span>
    </Aside>
    <ChildContent>
        <div class="aitest-note" role="note">
            <strong>@L("隐私与补录说明：", "Privacy and corrections: ")</strong>
            @L(
                "支付宝会显示实名，因此相关投食默认保密；如需展示附加信息、更改匿名状态，或发现记录遗漏，请联系群主或项目维护者。感谢每一位支持者。",
                "Alipay may expose real names, so those contributions are private by default. Contact the group owner or project maintainers to add a display note, change anonymity, or correct a missing record. Thank you to every supporter.")
        </div>

        <section class="aitest-panel">
            <div class="aitest-panel-heading">
                <h2>@L("投食名单", "Support records")</h2>
                <span class="aitest-badge">@SponsorCount @L("条记录", "records")</span>
            </div>

            @if (_sponsorRecord == null || _sponsorRecord.Count == 0)
            {
                <SiteEmptyState Icon="oi-heart"
                                Title="@L("暂时没有可展示的记录", "No records to display")"
                                Description="@L("完成隐私整理后的支持记录会出现在这里。", "Support records will appear here after their privacy details are reviewed.")" />
            }
            else
            {
                <div class="aitest-data-table-wrap">
                    <table class="aitest-data-table aitest-archive-table aitest-support-table"
                           aria-label="@L("投食名单", "Support records")">
                        <thead>
                            <tr>
                                <th scope="col">@L("投食人", "Supporter")</th>
                                <th scope="col">@L("留言", "Message")</th>
                                <th scope="col">@L("日期", "Date")</th>
                                <th scope="col">@L("金额", "Amount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _sponsorRecord)
                            {
                                <tr>
                                    <td data-label="@L("投食人", "Supporter")">
                                        @if (string.IsNullOrWhiteSpace(item?.MasterName))
                                        {
                                            <span class="aitest-badge">@L("匿名", "Anonymous")</span>
                                        }
                                        else
                                        {
                                            <strong>@item.MasterName</strong>
                                        }
                                    </td>
                                    <td data-label="@L("留言", "Message")">
                                        @if (string.IsNullOrWhiteSpace(item?.Message))
                                        {
                                            <span>@L("未留言", "No message")</span>
                                        }
                                        else
                                        {
                                            @item.Message
                                        }
                                    </td>
                                    <td data-label="@L("日期", "Date")">@(item == null ? "—" : item.Time.ToString("yyyy-MM-dd"))</td>
                                    <td data-label="@L("金额", "Amount")"><span class="aitest-rating">@(item == null ? "—" : item.Money.ToString("0.##"))</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </ChildContent>
</SitePage>

@code
