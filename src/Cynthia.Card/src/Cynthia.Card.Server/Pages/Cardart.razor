@page "/cardart"
@using System;
@using System.IO;
@using System.Collections.Generic;
@using System.Linq;
@using Microsoft.AspNetCore.Components;
@using Newtonsoft.Json;
@using Cynthia.Card.Common.Models.Localization;

@{
    var visibleCards = GetFilteredCards();
}

<div class="cardart-page">
    <div class="cardart-toolbar">
        <input class="cardart-search" type="text" value="@_searchText" @oninput="OnSearchInput"
               placeholder="搜索中英文名 / 卡图ID / 小窝卡牌ID / GWENT编号（空格分词）" autocomplete="off" />
        @if (!string.IsNullOrEmpty(_searchText))
        {
            <button class="cardart-clear" type="button" @onclick="ClearSearch">清除</button>
        }
        <span class="cardart-count">显示 @visibleCards.Count / 共 @_cards.Count 张</span>
    </div>

    @if (_cards.Count == 0)
    {
        <p class="cardart-empty">未在 ./wwwroot/scale 下找到卡图文件。</p>
    }
    else if (visibleCards.Count == 0)
    {
        <p class="cardart-empty">没有匹配「@_searchText」的卡图。</p>
    }
    else
    {
        <div class="cardart-grid">
            @foreach (var card in visibleCards)
            {
                <div class="card cardart-item" title="@card.Tooltip">
                    <img src="@($"./scale/{card.FileName}")" alt="@card.AltText" loading="lazy" />
                    <p class="card-text cardart-name-cn">@card.ChineseName</p>
                    <p class="cardart-name-en">@card.EnglishName</p>
                    <p class="cardart-artid">@card.ArtId</p>
                </div>
            }
        </div>
    }
</div>

<style>
    .cardart-toolbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        background: #f7f7f7;
        border-bottom: 1px solid #dddddd;
    }

    .cardart-search {
        flex: 1 1 260px;
        min-width: 200px;
        padding: 6px 10px;
        font-size: 14px;
        border: 1px solid #bbbbbb;
        border-radius: 4px;
    }

    .cardart-clear {
        padding: 5px 12px;
        font-size: 13px;
        cursor: pointer;
    }

    .cardart-count {
        color: #666666;
        font-size: 13px;
        white-space: nowrap;
    }

    .cardart-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px;
    }

    .cardart-item {
        width: 150px;
        padding: 0;
        border: 0;
        background: transparent;
    }

    .cardart-item img {
        display: block;
        width: 150px;
        height: auto;
        border-radius: 6px;
        background: #222222;
    }

    .cardart-name-cn {
        margin: 4px 0 0;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.25;
        word-break: break-word;
    }

    .cardart-name-en {
        margin: 1px 0 0;
        font-size: 12px;
        color: #555555;
        line-height: 1.25;
        word-break: break-word;
    }

    .cardart-artid {
        margin: 1px 0 0;
        font-size: 11px;
        color: #999999;
        font-family: Consolas, Menlo, monospace;
    }

    .cardart-empty {
        padding: 24px 12px;
        color: #666666;
    }
</style>

@code
{
    private sealed class CardArtItem
    {
        public string FileName { get; set; }
        public string ArtId { get; set; }
        public string ChineseName { get; set; }
        public string EnglishName { get; set; }
        public string SearchText { get; set; }
        public string AltText { get; set; }
        public string Tooltip { get; set; }
    }

    private sealed class CardNameInfo
    {
        // true 表示这行编号来自 GWENT 客户端 TemplateId，false 表示小窝项目卡号。
        public bool IsClientId { get; set; }
        public List<string> Ids { get; set; }
        public string ChineseName { get; set; }
        public string EnglishName { get; set; }
    }

    // ClientArtNames 的解析结果，保留每行的编号来源与拆分后的编号。
    private sealed class ClientArtRow
    {
        public string ArtId { get; set; }
        public bool IsClientId { get; set; }
        public List<string> Ids { get; set; }
        public string ChineseName { get; set; }
        public string EnglishName { get; set; }
    }

    private List<CardArtItem> _cards = new List<CardArtItem>();
    private string _searchText = "";

    // 没有已核实名称的卡图统一使用这两个占位名，不再臆测卡图身份。
    private const string UnknownChineseName = "未命名";
    private const string UnknownEnglishName = "Unnamed";

    // 提示里区分两种编号来源，不把项目卡号与客户端编号混写。
    private const string ProjectIdLabel = "小窝卡牌ID";
    private const string ClientIdLabel = "GWENT客户端编号";

    // 已核实名称表里唯一一条用项目卡号登记的记录（63010 是项目卡号，不是客户端TemplateId）。
    private const string ProjectNumberClientArtId = "d22990000";

    protected override void OnInitialized()
    {
        _cards = BuildCardArtItems();
    }

    /// <summary>
    /// 按中文名、英文名、卡图ID、小窝卡牌ID、GWENT客户端编号过滤，
    /// 多个关键词以空格分隔（全部命中才算匹配）。
    /// </summary>
    private List<CardArtItem> GetFilteredCards()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return _cards;
        }

        var keywords = _searchText.Split(
            new[] { ' ', '\t', '\r', '\n', '\u3000' },
            StringSplitOptions.RemoveEmptyEntries);

        if (keywords.Length == 0)
        {
            return _cards;
        }

        return _cards
            .Where(card => keywords.All(keyword =>
                card.SearchText.IndexOf(keyword, StringComparison.OrdinalIgnoreCase) >= 0))
            .ToList();
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchText = args?.Value?.ToString() ?? string.Empty;
    }

    private void ClearSearch()
    {
        _searchText = string.Empty;
    }

    public List<string> GetPngFileNames(string folderPath)
    {
        List<string> pngFileNames = new List<string>();

        if (!Directory.Exists(folderPath))
        {
            return pngFileNames;
        }

        foreach (string filePath in Directory.GetFiles(folderPath, "*.png"))
        {
            string fileName = Path.GetFileName(filePath);
            pngFileNames.Add(fileName);
        }

        pngFileNames.Sort(StringComparer.OrdinalIgnoreCase);
        return pngFileNames;
    }

    private List<CardArtItem> BuildCardArtItems()
    {
        var artNames = BuildArtNameMap();
        var items = new List<CardArtItem>();

        foreach (var fileName in GetPngFileNames("./wwwroot/scale"))
        {
            var artId = Path.GetFileNameWithoutExtension(fileName) ?? string.Empty;
            var chineseNames = new List<string>();
            var englishNames = new List<string>();
            var searchIds = new List<string>();
            var detailLines = new List<string>();
            var shownNamePairs = new HashSet<string>(StringComparer.Ordinal);

            if (artNames.TryGetValue(artId, out var infos))
            {
                foreach (var info in infos)
                {
                    if (!string.IsNullOrWhiteSpace(info.ChineseName) && !chineseNames.Contains(info.ChineseName))
                    {
                        chineseNames.Add(info.ChineseName);
                    }

                    if (!string.IsNullOrWhiteSpace(info.EnglishName) && !englishNames.Contains(info.EnglishName))
                    {
                        englishNames.Add(info.EnglishName);
                    }

                    foreach (var id in info.Ids)
                    {
                        if (!string.IsNullOrWhiteSpace(id) && !searchIds.Contains(id))
                        {
                            searchIds.Add(id);
                        }
                    }

                    // 每条来源单独成行，明确区分小窝卡牌ID与GWENT客户端编号；
                    // 同一名称只写一次，避免重复显示。
                    var idText = string.Join(", ", info.Ids);
                    var idLabel = info.IsClientId ? ClientIdLabel : ProjectIdLabel;
                    var namePair = string.Join(" / ", new[] { info.ChineseName, info.EnglishName }
                        .Where(name => !string.IsNullOrWhiteSpace(name)));
                    if (namePair.Length > 0 && shownNamePairs.Add(namePair))
                    {
                        detailLines.Add($"{idLabel} {idText}：{namePair}");
                    }
                    else
                    {
                        detailLines.Add($"{idLabel} {idText}");
                    }
                }
            }

            var chinese = string.Join(" / ", chineseNames);
            var english = string.Join(" / ", englishNames);
            var hasName = !string.IsNullOrEmpty(chinese) || !string.IsNullOrEmpty(english);

            // 没有已核实名称的卡图统一显示“未命名 / Unnamed”，占位名同样参与检索。
            if (!hasName)
            {
                chinese = UnknownChineseName;
                english = UnknownEnglishName;
            }

            var searchParts = new List<string> { fileName, artId, chinese, english };
            searchParts.AddRange(searchIds);

            items.Add(new CardArtItem
            {
                FileName = fileName,
                ArtId = artId,
                ChineseName = chinese,
                EnglishName = english,
                SearchText = string.Join(" ", searchParts),
                // 占位名不是卡图身份，alt 只保留卡图ID。
                AltText = hasName ? $"{chinese} {english} {artId}".Trim() : artId,
                Tooltip = hasName
                    ? $"{string.Join("\n", detailLines)}\n卡图ID：{artId}"
                    : $"卡图ID：{artId}（未收录卡牌名称）",
            });
        }

        items.Sort((left, right) => string.CompareOrdinal(left.FileName, right.FileName));
        return items;
    }

    /// <summary>
    /// 建立 卡图ID -> 卡牌名称 的映射，数据来自 GwentMap 与 Locales 下的多语言词条，
    /// 再用客户端卡图名称表补齐。这里只包含已核实名称；查不到名称的卡图由调用方
    /// 统一显示为未命名占位名。
    /// </summary>
    private static Dictionary<string, List<CardNameInfo>> BuildArtNameMap()
    {
        var chineseLocale = LoadLocale("cn");
        var englishLocale = LoadLocale("en");
        var map = new Dictionary<string, List<CardNameInfo>>(StringComparer.OrdinalIgnoreCase);

        var clientRows = ParseClientArtRows();
        // 已核实名称表给出的 客户端TemplateId -> 所有实际卡图ID 索引（多编号行逐一拆分）。
        var clientTemplateArtIndex = BuildIndex(clientRows, isClientId: true);
        // 唯一以项目卡号登记的特例（d22990000 的 63010），单独建索引，不并入客户端编号。
        var clientProjectArtIndex = BuildIndex(clientRows, isClientId: false);

        foreach (var pair in GwentMap.CardMap)
        {
            var card = pair.Value;
            var cardArtsId = card.CardArtsId;
            if (string.IsNullOrWhiteSpace(cardArtsId))
            {
                continue;
            }

            var chineseName = GetLocaleCardName(chineseLocale, pair.Key);
            if (string.IsNullOrWhiteSpace(chineseName))
            {
                chineseName = card.Name;
            }

            // 优先使用 Locales 既有英文，仅在缺失时使用本页补充译名。
            var englishName = GetLocaleCardName(englishLocale, pair.Key);
            if (string.IsNullOrWhiteSpace(englishName))
            {
                englishName = GetSupplementalEnglish(englishLocale, pair.Key);
            }

            var info = new CardNameInfo
            {
                IsClientId = false,
                Ids = new List<string> { pair.Key },
                ChineseName = chineseName,
                EnglishName = englishName,
            };

            // 原有行为：CardArtsId 直接对应同名卡图。
            AddNameInfo(map, cardArtsId, info);

            // 新增关联：GwentMap.CardArtsId 若是已核实的客户端 TemplateId，
            // 就把该项目的卡号与中英文名称挂到该编号对应的所有实际卡图上。
            if (clientTemplateArtIndex.TryGetValue(cardArtsId, out var templateArts))
            {
                foreach (var artId in templateArts)
                {
                    AddNameInfo(map, artId, info);
                }
            }

            // 特例：补充表中以项目卡号登记的行。
            if (clientProjectArtIndex.TryGetValue(pair.Key, out var projectArts))
            {
                foreach (var artId in projectArts)
                {
                    AddNameInfo(map, artId, info);
                }
            }
        }

        // 已核实名称表：官方名与项目名并存，只补充不覆盖。
        foreach (var row in clientRows)
        {
            AddNameInfo(map, row.ArtId, new CardNameInfo
            {
                IsClientId = row.IsClientId,
                Ids = row.Ids,
                ChineseName = row.ChineseName,
                EnglishName = row.EnglishName,
            });
        }

        return map;
    }

    /// <summary>
    /// 按 (来源, 编号) 去重后加入映射，避免同一项目卡或同一客户端编号重复出现。
    /// </summary>
    private static void AddNameInfo(Dictionary<string, List<CardNameInfo>> map, string artId, CardNameInfo info)
    {
        if (string.IsNullOrWhiteSpace(artId))
        {
            return;
        }

        if (!map.TryGetValue(artId, out var infos))
        {
            infos = new List<CardNameInfo>();
            map[artId] = infos;
        }

        foreach (var existing in infos)
        {
            if (existing.IsClientId == info.IsClientId && IdsEqual(existing.Ids, info.Ids))
            {
                return;
            }
        }

        infos.Add(info);
    }

    private static bool IdsEqual(List<string> left, List<string> right)
    {
        if (left == null || right == null)
        {
            return ReferenceEquals(left, right);
        }

        if (left.Count != right.Count)
        {
            return false;
        }

        for (var i = 0; i < left.Count; i++)
        {
            if (!string.Equals(left[i], right[i], StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>
    /// 由已核实名称表建立 编号 -> 实际卡图ID 的索引；多编号行按逗号逐一拆分。
    /// </summary>
    private static Dictionary<string, List<string>> BuildIndex(IEnumerable<ClientArtRow> rows, bool isClientId)
    {
        var index = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);

        foreach (var row in rows)
        {
            if (row.IsClientId != isClientId)
            {
                continue;
            }

            foreach (var id in row.Ids)
            {
                if (!index.TryGetValue(id, out var artIds))
                {
                    artIds = new List<string>();
                    index[id] = artIds;
                }

                if (!artIds.Contains(row.ArtId))
                {
                    artIds.Add(row.ArtId);
                }
            }
        }

        return index;
    }

    /// <summary>
    /// 解析已核实卡图名称表。每行格式：卡图ID|中文名|英文名|编号（多个编号以逗号分隔）。
    /// 第四列多数是客户端 TemplateId；唯一特例 d22990000 的 63010 是项目卡号，
    /// 单独标记为项目编号，不作为客户端编号建索引。
    /// </summary>
    private static List<ClientArtRow> ParseClientArtRows()
    {
        var rows = new List<ClientArtRow>();

        foreach (var rawLine in ClientArtNames.Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0 || line[0] == '#')
            {
                continue;
            }

            var parts = line.Split('|');
            if (parts.Length < 4)
            {
                continue;
            }

            var artId = parts[0].Trim();
            var chineseName = parts[1].Trim();
            var englishName = parts[2].Trim();
            if (artId.Length == 0 || (chineseName.Length == 0 && englishName.Length == 0))
            {
                continue;
            }

            var ids = parts[3].Split(',')
                .Select(id => id.Trim())
                .Where(id => id.Length > 0)
                .ToList();

            rows.Add(new ClientArtRow
            {
                ArtId = artId,
                IsClientId = !string.Equals(artId, ProjectNumberClientArtId, StringComparison.OrdinalIgnoreCase),
                Ids = ids,
                ChineseName = chineseName,
                EnglishName = englishName,
            });
        }

        return rows;
    }

