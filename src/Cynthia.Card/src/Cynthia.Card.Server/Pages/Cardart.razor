    /// <summary>
    /// 上游 Locales/en.json 缺少英文时的项目卡补充译名，仅覆盖已确认的 27 个项目卡号；
    /// 能从 Locales 读到的英文一律优先，不在此覆盖。
    /// “晋升”沿用基础卡既有英文并加 “: Ascended”（项目补充译名，不冒充官方文本）；
    /// 同名变体沿用基础卡既有英文。基础卡号来自逐条核对的中文名对应关系，
    /// 不使用“去掉末尾 0”之类的推断。
    /// </summary>
    private static readonly Dictionary<string, string> AscendedBaseCardIds =
        new Dictionary<string, string>(StringComparer.Ordinal)
    {
        { "130010", "13001" }, { "130020", "13002" }, { "130030", "13003" },
        { "130040", "13004" }, { "130050", "13005" }, { "130060", "13006" },
        { "130070", "13007" }, { "130080", "13008" }, { "130090", "13009" },
        { "130100", "13010" }, { "130120", "13012" }, { "130130", "13013" },
        { "130140", "13014" }, { "130150", "13015" }, { "130160", "13016" },
        { "130170", "13017" }, { "130180", "13018" }, { "130190", "13019" },
        { "130200", "13020" }, { "130210", "13021" }, { "130220", "13022" },
        { "240140", "24014" }, { "640080", "64008" },
    };

    private static readonly Dictionary<string, string> SameNameVariantBaseCardIds =
        new Dictionary<string, string>(StringComparer.Ordinal)
    {
        { "130110", "13011" }, // Carlo Varese
        { "240230", "24023" }, // Wyvern
        { "240250", "24025" }, // Barbegazi
    };

    // 上游没有 70018 词条；沿用 fork en.json 已有译名，保证只移植本页时也可用。
    private const string ReaverHunterNightmareArmorCardId = "70018";
    private const string ReaverHunterNightmareArmorEnglish = "Reaver Hunter's Nightmare Armor";

    private static string GetSupplementalEnglish(GameLocale englishLocale, string cardId)
    {
        if (string.Equals(cardId, ReaverHunterNightmareArmorCardId, StringComparison.Ordinal))
        {
            return ReaverHunterNightmareArmorEnglish;
        }

        if (SameNameVariantBaseCardIds.TryGetValue(cardId, out var variantBaseId))
        {
            // 同名变体保留基础卡既有英文，不添加后缀。
            return GetLocaleCardName(englishLocale, variantBaseId);
        }

        if (AscendedBaseCardIds.TryGetValue(cardId, out var ascendedBaseId))
        {
            var baseName = GetLocaleCardName(englishLocale, ascendedBaseId);
            if (!string.IsNullOrWhiteSpace(baseName))
            {
                return baseName + ": Ascended";
            }
        }

        return null;
    }

    private static string GetLocaleCardName(GameLocale locale, string cardId)
    {
        if (locale?.CardLocales == null)
        {
            return null;
        }

        if (locale.CardLocales.TryGetValue(cardId, out var cardLocale)
            && cardLocale != null
            && !string.IsNullOrWhiteSpace(cardLocale.Name))
        {
            return cardLocale.Name;
        }

        return null;
    }

    private static GameLocale LoadLocale(string language)
    {
        try
        {
            var path = Path.Combine(Directory.GetCurrentDirectory(), "Locales", language + ".json");
            if (!File.Exists(path))
            {
                return null;
            }

            return JsonConvert.DeserializeObject<GameLocale>(File.ReadAllText(path));
        }
        catch
        {
            return null;
        }
    }
