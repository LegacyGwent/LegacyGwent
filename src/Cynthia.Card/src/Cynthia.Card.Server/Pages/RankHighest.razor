@page "/rank2"
@using Microsoft.Extensions.Logging
@inject GwentServerService GwentService
@inject SiteTextService Text
@inject ILogger<RankHighest> Logger
@implements IDisposable

<SitePage Eyebrow="@Text["LadderArchive"]"
          Title="@Text["HighestLadderTitle"]"
          Description="@Text["HighestLadderDescription"]"
          Icon="oi-badge"
          CssClass="aitest-page--hall">
    <Aside>
        <strong>@_resultList.Count</strong>
        <span>@Text["RankedPlayers"]</span>
    </Aside>
    <ChildContent>
        <section class="aitest-panel">
            <div class="aitest-panel-heading">
                <h2>@Text["HighestLadderTitle"]</h2>
                <span class="aitest-badge">@Text["TopRankLimit"]</span>
            </div>

            @if (!string.IsNullOrEmpty(_loadError))
            {
                <SiteEmptyState Icon="oi-warning"
                                Title="@Text["DataUnavailableTitle"]"
                                Description="@Text["DataUnavailableBody"]" />
            }
            else
            {
                <RankingTable Items="@_resultList" RatingLabel="@Text["PeakRatingColumn"]" />
            }
        </section>
    </ChildContent>
</SitePage>

@code
{
    private IList<Tuple<string, int>> _resultList = new List<Tuple<string, int>>();
    private string _loadError = "";

    protected override void OnInitialized()
    {
        LoadRankings();
        GwentService.OnGameOver += OnGameOver;
    }

    private void LoadRankings()
    {
        try
        {
            _resultList = GwentService.GetAllHighestMMR(0, 500) ?? new List<Tuple<string, int>>();
            _loadError = "";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load peak MMR rankings");
            _resultList = new List<Tuple<string, int>>();
            _loadError = Text["DataUnavailableBody"];
        }
    }

    private void OnGameOver(GameResult newResult)
    {
        InvokeAsync(() =>
        {
            LoadRankings();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        GwentService.OnGameOver -= OnGameOver;
    }
}
