@page "/seasons"
@using System.Globalization
@using Microsoft.Extensions.Logging
@inject SeasonOverviewService SeasonOverview
@inject GwentLocalizationService Localization
@inject SiteTextService Text
@inject ILogger<Seasons> Logger

<SitePage Eyebrow="@Text["SeasonArchive"]"
          Title="@Text["SeasonsTitle"]"
          Description="@Text["SeasonsDescription"]"
          Icon="oi-calendar"
          CssClass="aitest-page--seasons">
    <Aside>
        <strong>@_seasons.Count</strong>
        <span>@Text["SeasonCount"]</span>
    </Aside>
    <ChildContent>
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <section class="aitest-panel">
                <SiteEmptyState Icon="oi-warning"
                                Title="@Text["DataUnavailableTitle"]"
                                Description="@Text["DataUnavailableBody"]" />
            </section>
        }
        else if (_seasons.Count == 0)
        {
            <section class="aitest-panel">
                <SiteEmptyState Icon="oi-calendar"
                                Title="@Text["NoSeasonsTitle"]"
                                Description="@Text["NoSeasonsBody"]" />
            </section>
        }
        else
        {
            <div class="aitest-season-stack">
                @foreach (var overview in _seasons)
                {
                    var season = overview.Season;
                    var activity = RecentActivity(overview);
                    var maxActivity = activity.Count == 0 ? 1 : activity.Max(day => day.Matches);

                    <article class="aitest-panel aitest-season-panel @(season.isActive ? "is-active" : "")">
                        <header class="aitest-panel-heading">
                            <div class="aitest-season-title">
                                <h2>@SeasonName(season)</h2>
                                <p>@FormatDate(season.SeasonStartTime) — @FormatDate(season.SeasonEndTime)</p>
                            </div>
                            <div class="aitest-season-status">
                                <span class="aitest-badge @(season.isActive ? "is-active" : "")">@SeasonStatus(season)</span>
                                @if (season.areRewardsGranted)
                                {
                                    <span class="aitest-badge">@Text["RewardsGranted"]</span>
                                }
                            </div>
                        </header>

                        <div class="aitest-season-summary">
                            <div class="aitest-season-stat">
                                <strong>@overview.MatchCount</strong>
                                <span>@Text["RankedMatches"]</span>
                            </div>
                            <div class="aitest-season-stat">
                                <strong>@overview.PlayerPicks</strong>
                                <span>@Text["PlayerPicks"]</span>
                            </div>
                            <div class="aitest-season-stat">
                                <strong>@overview.ActiveDays</strong>
                                <span>@Text["ActiveDays"]</span>
                            </div>
                        </div>

                        <section class="aitest-season-section">
                            <div class="aitest-season-section-head">
                                <h3>@Text["DailyActivity"]</h3>
                                <span>@Text["RecentActivityWindow"]</span>
                            </div>
                            @if (activity.Count == 0)
                            {
                                <div class="aitest-note">@Text["NoMatchesBody"]</div>
                            }
                            else
                            {
                                <div class="aitest-activity-chart" aria-hidden="true">
                                    @foreach (var day in activity)
                                    {
                                        <span class="aitest-activity-bar"
                                              style="@ActivityHeight(day.Matches, maxActivity)"
                                              data-label="@ActivityLabel(day)"
                                              title="@ActivityLabel(day)"></span>
                                    }
                                </div>
                                <ul class="sr-only">
                                    @foreach (var day in activity)
                                    {
                                        <li>@ActivityLabel(day)</li>
                                    }
                                </ul>
                            }
                        </section>

                        <section class="aitest-season-section">
                            <div class="aitest-season-section-head">
                                <h3>@Text["FactionBreakdown"]</h3>
                                <span>@overview.PlayerPicks @Text["PlayerPicks"]</span>
                            </div>
                            <div class="aitest-data-table-wrap">
                                <table class="aitest-data-table aitest-faction-table" aria-label="@Text["FactionBreakdown"]">
                                    <thead>
                                        <tr>
                                            <th scope="col">@Text["FactionColumn"]</th>
                                            <th scope="col">@Text["PicksColumn"]</th>
                                            <th scope="col">@Text["WinsColumn"]</th>
                                            <th scope="col">@Text["DrawsColumn"]</th>
                                            <th scope="col">@Text["LossesColumn"]</th>
                                            <th scope="col">@Text["WinRateColumn"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var faction in overview.Factions.OrderByDescending(item => item.Picks))
                                        {
                                            <tr>
                                                <td data-label="@Text["FactionColumn"]"><strong>@FactionName(faction.Faction)</strong></td>
                                                <td data-label="@Text["PicksColumn"]">@faction.Picks</td>
                                                <td data-label="@Text["WinsColumn"]">@faction.Wins</td>
                                                <td data-label="@Text["DrawsColumn"]">@faction.Draws</td>
                                                <td data-label="@Text["LossesColumn"]">@faction.Losses</td>
                                                <td data-label="@Text["WinRateColumn"]"><span class="aitest-rating">@faction.WinRate.ToString("0.0")%</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>

                        <section class="aitest-season-section">
                            <div class="aitest-season-section-head">
                                <h3>@Text["SeasonRewards"]</h3>
                                <span>@((season.seasonalRewards ?? new List<SeasonReward>()).Count)</span>
                            </div>
                            @if (season.seasonalRewards == null || season.seasonalRewards.Count == 0)
                            {
                                <div class="aitest-note">@Text["NoRewards"]</div>
                            }
                            else
                            {
                                <div class="aitest-reward-grid">
                                    @foreach (var reward in season.seasonalRewards.OrderBy(item => item.minimalPosition))
                                    {
                                        <div class="aitest-reward">
                                            <strong>@RewardRequirement(reward)</strong>
                                            <span>@RewardContents(reward)</span>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    </article>
                }
            </div>
        }
    </ChildContent>
</SitePage>

@code
{
    private IList<SeasonOverview> _seasons = new List<SeasonOverview>();
    private string _loadError = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = (await SeasonOverview.GetAsync()).ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to build season overview");
            _seasons = new List<SeasonOverview>();
            _loadError = Text["DataUnavailableBody"];
        }
    }

    private IList<DayActivity> RecentActivity(SeasonOverview overview)
    {
        var activity = (overview.Activity ?? new List<DayActivity>())
            .Where(day => day != null && day.Matches > 0)
            .ToList();
        return activity.Skip(Math.Max(0, activity.Count - 32)).ToList();
    }

    private string SeasonName(SeasonInfo season)
    {
        if (!string.IsNullOrWhiteSpace(season?.SeasonName))
        {
            var localizedName = Localization.GetMenuText(
                Text.IsEnglish ? "en" : "cn",
                season.SeasonName);
            return string.IsNullOrWhiteSpace(localizedName)
                ? HumanizeResourceId(season.SeasonName)
                : localizedName;
        }

        return Text.IsEnglish ? $"Season {season?.SeasonId}" : $"第 {season?.SeasonId} 赛季";
    }

    private string SeasonStatus(SeasonInfo season)
    {
        if (season.isActive)
        {
            return Text["ActiveSeason"];
        }

        return DateTime.UtcNow < season.SeasonStartTime
            ? Text["UpcomingSeason"]
            : Text["CompletedSeason"];
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString(Text.IsEnglish ? "MMM d, yyyy" : "yyyy 年 M 月 d 日");
    }

    private string ActivityHeight(int matches, int maximum)
    {
        var percentage = Math.Max(5d, matches * 100d / Math.Max(1, maximum));
        return "height:" + percentage.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private string ActivityLabel(DayActivity day)
    {
        var date = day.Date.ToString(Text.IsEnglish ? "MMM d" : "M 月 d 日");
        return Text.IsEnglish ? $"{date}: {day.Matches}" : $"{date}：{day.Matches} 场";
    }

    private string FactionName(Faction faction)
    {
        switch (faction)
        {
            case Faction.NorthernRealms:
                return Text["NorthernRealms"];
            case Faction.Nilfgaard:
                return Text["Nilfgaard"];
            case Faction.Skellige:
                return Text["Skellige"];
            case Faction.ScoiaTael:
                return Text["ScoiaTael"];
            case Faction.Monsters:
                return Text["Monsters"];
            default:
                return faction.ToString();
        }
    }

    private string RewardRequirement(SeasonReward reward)
    {
        if (reward.isInSeasonReward && reward.minimalMMR > 0)
        {
            return $"{Text["MmrRequirement"]} ≥ {reward.minimalMMR}";
        }

        return Text.IsEnglish
            ? $"{Text["PositionRequirement"]} ≤ {reward.minimalPosition}"
            : $"{Text["PositionRequirement"]}前 {reward.minimalPosition}";
    }

    private string RewardContents(SeasonReward reward)
    {
        var contents = new[] { reward.avatar, reward.border, reward.title }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(LocalizeResourceId);
        var text = string.Join(" · ", contents);
        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    private string LocalizeResourceId(string resourceId)
    {
        var localized = Localization.GetMenuText(
            Text.IsEnglish ? "en" : "cn",
            resourceId);
        return string.IsNullOrWhiteSpace(localized)
            ? HumanizeResourceId(resourceId)
            : localized;
    }

    private static string HumanizeResourceId(string resourceId)
    {
        if (string.IsNullOrWhiteSpace(resourceId))
        {
            return "—";
        }

        var value = resourceId.StartsWith("Season_", StringComparison.Ordinal)
            ? resourceId.Substring("Season_".Length)
            : resourceId;
        return value.Replace('_', ' ');
    }
}
