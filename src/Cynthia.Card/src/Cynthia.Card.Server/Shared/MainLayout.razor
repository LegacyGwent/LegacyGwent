@inherits LayoutComponentBase
@using Microsoft.Extensions.Logging
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject SiteTextService Text
@inject SiteSessionService SiteSession
@inject Microsoft.Extensions.Logging.ILogger<MainLayout> Logger

<div class="aitest-shell">
    <a class="aitest-skip-link" href="#aitest-main-content">@Text["SkipToContent"]</a>
    <aside class="aitest-sidebar">
        <NavMenu />
    </aside>

    <main class="aitest-main">
        <header class="aitest-toolbar">
            <div class="aitest-service-state" title="@Text["ServiceOnline"]">
                <span class="aitest-live-dot" aria-hidden="true"></span>
                <span>@Text["ServiceOnline"]</span>
                <strong>5010</strong>
            </div>

            <div class="aitest-toolbar-actions">
                <LanguageSwitcher />

                <div class="aitest-auth">
                    @if (loginFailed)
                    {
                        <div class="aitest-login-error" role="alert">@Text["LoginFailed"]</div>
                    }

                    @if (!isLogin)
                    {
                        @if (isLogining)
                        {
                            <span class="aitest-login-pending">@Text["LoggingIn"]</span>
                        }
                        else
                        {
                            <form class="aitest-auth-form" @onsubmit="Login" @onsubmit:preventDefault>
                                <input class="aitest-auth-input"
                                       aria-label="@Text["Account"]"
                                       autocomplete="username"
                                       placeholder="@Text["Account"]"
                                       type="text"
                                       @bind="input_user"
                                       @bind:event="oninput" />
                                <input class="aitest-auth-input"
                                       aria-label="@Text["Password"]"
                                       autocomplete="current-password"
                                       placeholder="@Text["Password"]"
                                       type="password"
                                       @bind="input_password"
                                       @bind:event="oninput" />
                                <button class="aitest-button aitest-button-compact" type="submit">
                                    @Text["Login"]
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <span class="aitest-user-name">@Text.Format("WelcomeUser", user)</span>
                        <button class="aitest-text-button" type="button" @onclick="Logout">@Text["Logout"]</button>
                    }
                </div>
            </div>
        </header>

        <CascadingValue Value="user">
            <div class="aitest-content" id="aitest-main-content" tabindex="-1">
                @Body
            </div>
        </CascadingValue>
    </main>
</div>

@code
{
    bool isLogin = false;
    bool isLogining = true;
    bool loginFailed = false;
    string input_user = "";
    string input_password = "";
    string user = "";
    const string localStorageSessionKey = "DiyAi.SiteSession.v1";
    const string legacyLocalStorageUserName = "USER_NAME";

    async Task Login()
    {
        if (isLogining)
        {
            return;
        }

        var submittedUser = (input_user ?? string.Empty).Trim();
        var submittedPassword = input_password ?? string.Empty;
        if (string.IsNullOrWhiteSpace(submittedUser) || string.IsNullOrEmpty(submittedPassword))
        {
            loginFailed = true;
            isLogining = false;
            return;
        }

        isLogining = true;
        loginFailed = false;
        try
        {
            if (Command.Login(submittedUser, submittedPassword))
            {
                user = submittedUser;
                isLogin = true;
                var sessionToken = SiteSession.Create(user);
                await localStorage.SetItemAsync(localStorageSessionKey, sessionToken);
                await localStorage.SetItemAsync(legacyLocalStorageUserName, string.Empty);
                input_user = string.Empty;
                input_password = string.Empty;
            }
            else
            {
                loginFailed = true;
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Website sign-in failed without terminating the circuit");
            user = string.Empty;
            isLogin = false;
            loginFailed = true;
        }
        finally
        {
            isLogining = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        isLogining = true;
        try
        {
            var token = await localStorage.GetItemAsync<string>(localStorageSessionKey);
            if (SiteSession.TryRead(token, out var verifiedUser))
            {
                user = verifiedUser;
                isLogin = true;
            }
            else
            {
                await localStorage.SetItemAsync(localStorageSessionKey, string.Empty);
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Website session restore failed without terminating the circuit");
            user = string.Empty;
            isLogin = false;
            loginFailed = true;
        }
        finally
        {
            isLogining = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    async Task Logout()
    {
        try
        {
            await localStorage.SetItemAsync(localStorageSessionKey, string.Empty);
            await localStorage.SetItemAsync(legacyLocalStorageUserName, string.Empty);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Website session storage could not be cleared");
        }
        finally
        {
            user = string.Empty;
            isLogin = false;
            loginFailed = false;
        }
    }
}
