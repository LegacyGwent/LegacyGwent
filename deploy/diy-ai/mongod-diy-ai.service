[Unit]
Description=MongoDB for Legacy Gwent DIY-AI
After=network.target

[Service]
Type=simple
# The legacy host's mongodb account has a mismatched primary group. sudo drops
# both identities consistently before replacing itself with mongod.
ExecStart=/usr/bin/sudo -u mongodb -g mongodb /usr/bin/mongod --dbpath /var/lib/mongodb-diy-ai --bind_ip 127.0.0.1 --port 28021 --logpath /var/log/mongodb/mongod-diy-ai.log --logappend
Restart=on-failure
RestartSec=5s
LimitNOFILE=64000

[Install]
WantedBy=multi-user.target
