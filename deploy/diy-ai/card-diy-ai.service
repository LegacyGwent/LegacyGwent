[Unit]
Description=Legacy Gwent DIY-AI server
After=network-online.target mongod-diy-ai.service
Requires=mongod-diy-ai.service

[Service]
Type=simple
WorkingDirectory=/usr/share/card-diy-ai/current
EnvironmentFile=/etc/card-diy-ai.env
# The legacy host returns 127 for systemd's User=/Group= execution path.
# sudo drops both identities consistently before starting dotnet.
ExecStart=/usr/bin/sudo -E -u card-diy-ai -g card-diy-ai /usr/bin/dotnet /usr/share/card-diy-ai/current/Cynthia.Card.Server.dll
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
MemoryLimit=2G

[Install]
WantedBy=multi-user.target
